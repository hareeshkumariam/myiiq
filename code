      <Source>
        import sailpoint.api.IdentityService;
        import sailpoint.api.Workflower;
        import sailpoint.object.Application;
        import sailpoint.object.Identity;
        import sailpoint.object.Link;
        import sailpoint.object.ProvisioningPlan;
        import sailpoint.object.ProvisioningPlan.AccountRequest;
        import sailpoint.object.WorkflowLaunch;

        import java.util.ArrayList;
        import java.util.HashMap;
        import java.util.LinkedHashMap;
        import java.util.List;
        import java.util.Map;

        import org.apache.commons.logging.Log;
        import org.apache.commons.logging.LogFactory;

        private static Log logger =
        LogFactory.getLog("Rest API Workflow");

        logger.info("Starting bulk provisioning");

        List usersToBeDeactivated =
        (List) workflow.get("usersToBeDeactivated");


        List usersalreadyBeDeactivated =
        (List) workflow.get("ineligibleUsers");


        Map requestIdToUserName = new LinkedHashMap();

        if (usersToBeDeactivated == null ||
        usersToBeDeactivated.isEmpty()) {

        logger.warn("No eligible users found.");

        workflow.put("requestIdToUserName",
        requestIdToUserName);

        workflow.put("message", "No eligible users found.");

        } else {

        Application application =
        context.getObjectByName(Application.class, "neymar");

        if (application == null) {
        throw new Exception(
        "Application 'neymar' was not found.");
        }

        IdentityService idSvc = new IdentityService(context);

        for (Object userObj : usersToBeDeactivated) {

        String uid = String.valueOf(userObj);

        try {

        logger.info("Processing user: " + uid);

        Identity identity =
        context.getObjectByName(Identity.class, uid);

        if (identity == null) {
        logger.warn(
        "Identity not found: " + uid);
        continue;
        }

        List links = idSvc.getLinks(identity, application);
        Link matchingLink = null;

        if (links != null) {
        for (Object linkObj : links) {

        Link link = (Link) linkObj;
        Object empId =
        link.getAttribute("Emp_id");

        if (!link.isDisabled()
        &amp;&amp; empId != null
        &amp;&amp; uid.equalsIgnoreCase(
        String.valueOf(empId))) {

        matchingLink = link;
        break;
        }
        }
        }

        if (matchingLink == null) {
        logger.warn(
        "No matching enabled account found for: "
        + uid);
        continue;
        }

        ProvisioningPlan plan = new ProvisioningPlan();
        plan.setIdentity(identity);
        plan.setNativeIdentity(identity.getName());

        AccountRequest accReq = new AccountRequest();

        accReq.setApplication(
        matchingLink.getApplicationName());

        accReq.setNativeIdentity(
        matchingLink.getNativeIdentity());

        accReq.setOperation(
        AccountRequest.Operation.Disable);

        List accountReqList = new ArrayList();
        accountReqList.add(accReq);

        plan.setAccountRequests(accountReqList);

        Map args = new HashMap();

        args.put("plan", plan);
        args.put("identityName", identity.getName());
        args.put("flow", "AccountsRequest");
        args.put("doRefresh", "true");
        args.put("source", "LCM");
        args.put("launcher", context.getUserName());
        args.put("approvalMode", "any");

        Object countObj =
        workflow.get("requestedUsersCount");

        int requestedCount = 0;

        if (countObj instanceof Number) {
        requestedCount =
        ((Number) countObj).intValue();
        } else if (countObj != null) {
        requestedCount =
        Integer.parseInt(countObj.toString());
        }

        if (requestedCount > 5) {
        args.put("approvalScheme", "manager");
        } else {
        args.put("approvalScheme", "none");
        }

        args.put("notificationScheme", "none");
        args.put("noFiltering", "true");
        args.put("foregroundProvisioning", "true");

        WorkflowLaunch wflaunch = new WorkflowLaunch();

        wflaunch.setWorkflowRef("LCM Provisioning");
        wflaunch.setVariables(args);

        Workflower workflower = new Workflower(context);

        wflaunch = workflower.launch(wflaunch);

        logger.info(
        "Workflow status for " + uid + ": "
        + wflaunch.getStatus());

        logger.info(
        "Workflow messages for " + uid + ": "
        + wflaunch.getMessages());

        // Retrieve the Identity Request ID
        String accessRequestId = null;

        if (wflaunch.getTaskResult() != null) {

        Object requestIdObj =
        wflaunch.getTaskResult().getAttribute(
        "identityRequestId");

        if (requestIdObj != null) {
        accessRequestId =
        String.valueOf(requestIdObj);
        }
        }

        // Store request ID as key and user name as value
        if (accessRequestId != null
        &amp;&amp; !accessRequestId.trim().isEmpty()) {

        requestIdToUserName.put(
        identity.getName(),accessRequestId);

        logger.info(
        "Stored request ID: " + accessRequestId
        + ", User: " + identity.getName());

        } else {

        logger.warn(
        "Request ID was not returned for user: "
        + uid);
        }

        } catch (Exception e) {

        logger.error(
        "Error processing user: " + uid, e);
        }
        }

        // Save the map for the next workflow step
        workflow.put("requestIdToUserName",
        requestIdToUserName);

        logger.info(
        "Final request ID to user name map: "
        + requestIdToUserName);

        workflow.put(
        "message",
        "Request ID to user name map: "
        + requestIdToUserName);
        }

        return null;
      </Source>
