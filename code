  <Step icon="Default" name="check provision step" posX="568" posY="18">
    <Script>
      <Source>import sailpoint.object.*;
import sailpoint.object.ProvisioningPlan;
import org.apache.commons.logging.Log;
import org.apache.commons.logging.LogFactory;

private static Log logger =
    LogFactory.getLog("Service Now Workflow");

logger.info("Entered Check Provision Status step");

ProvisioningPlan plan =
    (ProvisioningPlan) workflow.get("plan");

String currentUser =
    (String) workflow.get("currentUser");

Integer currentUserIndex =
    (Integer) workflow.get("currentUserIndex");

List usersToBeDeactivated =
    (List) workflow.get("usersToBeDeactivated");

String message = "";

if (plan == null) {
    message = "Provisioning plan not found for user: " + currentUser;
    logger.error(message);
} else {
    ProvisioningPlan.AccountRequest accountRequest =
        (ProvisioningPlan.AccountRequest) plan.getAccountRequests().get(0);

    ProvisioningResult result =
        accountRequest.getResult();

    if (result != null &amp;&amp;
        ProvisioningResult.STATUS_COMMITTED.equals(result.getStatus())) {

        message = "AD account disabled successfully for user: "
            + currentUser;

        logger.info(message);

    } else {
        message = "AD account disable failed or is incomplete for user: "
            + currentUser;

        if (result != null &amp;&amp; result.getErrors() != null) {
            message = message + ". Errors: " + result.getErrors();
        }

        logger.error(message);
    }
}

workflow.put("currentUserProvisioningMessage", message);

// Move to the next user after recording this user's result
if (currentUserIndex == null) {
    currentUserIndex = Integer.valueOf(0);
}

workflow.put("currentUserIndex",
    Integer.valueOf(currentUserIndex.intValue() + 1));

return true;</Source>
