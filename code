<!DOCTYPE Rule PUBLIC "sailpoint.dtd" "sailpoint.dtd">
<Rule language="beanshell" name="Pge-Rule-name" >
  <Source>

  import java.util.ArrayList;
import java.util.Arrays;
import java.util.HashMap;
import java.util.Iterator;
import java.util.List;
import java.util.Map;

import sailpoint.api.SailPointContext;
import sailpoint.api.SailPointFactory;
import sailpoint.object.EmailOptions;
import sailpoint.object.EmailTemplate;
import sailpoint.object.Filter;
import sailpoint.object.Identity;
import sailpoint.object.ManagedAttribute;
import sailpoint.object.QueryOptions;
import sailpoint.tools.GeneralException;
  import sailpoint.object.TaskResult;
  
  
String HIGH_RISK_CLASSIFICATION = "highRisk";  
String EMAIL_TEMPLATE_NAME = "some email template";  
		



 boolean  sendNotification(List<String>recipientList,ManagedAttribute entitlement,String reason) {
		
		try {
			SailPointContext context = SailPointFactory.getCurrentContext();
        if (recipientList == null || recipientList.isEmpty()) {
        	//log.warn("Recipient is null. Email not sent.");
            return false;
        }
        
        List<String> recipients = new ArrayList();
        List<String> recipientsNames = new ArrayList();
        for(String userName : recipientList) {
        	
        	Identity iden = context.getObjectByName(Identity.class, userName);
        	if(iden == null) {
        		continue;
        	}
        	recipients.add(iden.getEmail());
        	recipientsNames.add(iden.getDisplayName());
        }

        String recipientEmails = String.join(",", recipientList);
        if (recipientEmails == null || recipientEmails.isEmpty()) {
        	//log.warn("No email address found for identity: "+ recipient.getName());
        	 return false;
        }

        EmailTemplate template = context.getObjectByName(EmailTemplate.class,"");

        if (template == null) {
        	//log.error("Email template not found: "+ templateName);
        	 return false;
        }

        Map args = new HashMap();
        args.put("entitlementName",entitlement.getName());
        args.put("entitlementValue",entitlement.getValue());
        args.put("applicationName",entitlement.getApplication().getName());
        args.put("recipientName",recipientsNames);
        args.put("reason",reason);
        EmailOptions options = new EmailOptions(recipientEmails, args);
        context.sendEmailNotification( template, options);
      //log.info( "Email sent to [" + recipient.getName() + "] for entitlement [" + entitlement.getName() + "]" );
        return true;
		}catch (Exception e) {
			return false;
		}
        
    }
	
	//rule start here
	
	Map resultMap = new HashMap();
	try {
			QueryOptions qo = new QueryOptions();
			qo.addFilter(Filter.eq("classifications.classification.name",HIGH_RISK_CLASSIFICATION)
		);
		qo.setDistinct(true);
		    Iterator iterator = context.search(ManagedAttribute.class,qo);
		    int highRiskEntitlements = 0;
		    int emailsSent = 0;
		    
		    List<String> activeMetaDataOwnerList = new ArrayList<String>();
		    while (iterator.hasNext()) {
		        ManagedAttribute ma = (ManagedAttribute) iterator.next();
		        highRiskEntitlements++;
		        //log.info("Processing HIGH RISK entitlement: "+ ma.getName());
		        Object metadataOwnersObject = ma.getAttribute("metadataOwners");
		        List metadataOwnerNames = new ArrayList();

		      if (metadataOwnersObject != null) {
		            String ownersString = metadataOwnersObject.toString();
		            List<String> ownerList = Arrays.asList(ownersString.split(","));
		            
		            for (String owner : ownerList) {
		                if (owner != null) {
		                	 Identity ownerIden = context.getObjectByName(Identity.class, owner);
		                	 
		                	 if(ownerIden == null) {
		                		 continue;
		                	 } else {
		                		 boolean isInActive = ownerIden.isInactive();
		                		 
		                		 if(isInActive) {
		                			continue;
		                		 } else {
		                			 activeMetaDataOwnerList.add(owner);
		                		 }
		                	 }
		                   
		                }
		            }
		            
		            if(activeMetaDataOwnerList == null) {
		            	String primaryApprover = (String) ma.getAttribute("primaryApprover");
		            	List<String> primaryApproverList = Arrays.asList(primaryApprover.split(","));
		            	String secondaryApprover = (String) ma.getAttribute("secondaryApprovers");
		            	List<String> secondaryApproverList = Arrays.asList(secondaryApprover.split(","));
		            	
		            	if((primaryApproverList == null || !primaryApproverList.isEmpty()) && (secondaryApproverList == null || !secondaryApproverList.isEmpty())) {
		            		continue;
		            	} else {
		            		
		            		List<String> receiptsList = new ArrayList<String>();
		            		
		            		for(String user : primaryApproverList) {
		            			receiptsList.add(user);
		            		}
		            		 for(String user : secondaryApproverList) {
		            			 
		            			 receiptsList.add(user);
		            		 }
		            		// Send Email
		            		boolean isEmailSent = sendNotification(receiptsList, ma, "reason");
		            		if(isEmailSent) {
		            			emailsSent++;
		            		}
		            		
		            	}
		            }
		            boolean isEmailSent = sendNotification(activeMetaDataOwnerList, ma, "reason");
            		if(isEmailSent) {
            			emailsSent++;
            		}
            		
		        }else {
		        	
		        	String primaryApprover = (String) ma.getAttribute("primaryApprover");
	            	List<String> primaryApproverList = Arrays.asList(primaryApprover.split(","));
	            	String secondaryApprover = (String) ma.getAttribute("secondaryApprovers");
	            	List<String> secondaryApproverList = Arrays.asList(secondaryApprover.split(","));
	            	
	            	if((primaryApproverList == null || !primaryApproverList.isEmpty()) && (secondaryApproverList == null || !secondaryApproverList.isEmpty())) {
	            		continue;
	            	} else {
	            		List<String> receiptsList = new ArrayList<String>();
	            		
	            		for(String user : primaryApproverList) {
	            			receiptsList.add(user);
	            		}
	            		 for(String user : secondaryApproverList) {
	            			 
	            			 receiptsList.add(user);
	            		 }
	            		// Send Email
	            		boolean isEmailSent = sendNotification(receiptsList, ma, "reason");
	            		if(isEmailSent) {
	            			emailsSent++;
	            		}
	            		
	            		
	            	}
		        	
		        	
		        }

	
		    context.decache();
		    }

			resultMap.put("totalHihgRiskEntitlements :" ,highRiskEntitlements);
    resultMap.put("emailCount :" ,emailsSent);
		} catch (Exception e) {
			
		}
		
 if (taskResult != null) {
    taskResult.setAttribute("output", resultMap);
    context.saveObject(taskResult);
    context.commitTransaction();
  }


  </Source>
</Rule>

