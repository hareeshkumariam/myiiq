    <Script>
      <Source>
        import sailpoint.object.*;
        import sailpoint.api.IdentityService;
        import java.util.List;
        import java.util.ArrayList;
        import java.util.Set;
        import java.util.HashSet;

        import org.apache.commons.logging.Log;
        import org.apache.commons.logging.LogFactory;

        private static Log logger =
        LogFactory.getLog("Rest API Workflow");

        logger.info("Entered Validation Step for Rest API Users");

        // Read comma-separated users from workflow input
        String users = (String) workflow.get("users");

        Set usersSet = new HashSet();

        if (users != null &amp;&amp; !users.trim().isEmpty()) {

        String[] userArray = users.split(",");

        for (String uid : userArray) {

        if (uid != null &amp;&amp; !uid.trim().isEmpty()) {
        usersSet.add(uid.trim());
        }
        }
        }

        // Count distinct, non-empty users
        int requestedUsersCount = usersSet.size();

        workflow.put("requestedUsersCount",
        Integer.valueOf(requestedUsersCount));

        // More than 5 users: approval required
        String selectedApprovalScheme = "none";

        if (requestedUsersCount > 5) {
        selectedApprovalScheme = "spadmin";
        }

        workflow.put("approvalScheme", selectedApprovalScheme);

        logger.info("Requested users count: " + requestedUsersCount);
        logger.info("Selected approval scheme: " + selectedApprovalScheme);

        List validUsersList = new ArrayList();
        List invalidUsersList = new ArrayList();

        Application application =
        context.getObjectByName(Application.class, "neymar");

        IdentityService idSvc = new IdentityService(context);

        for (Object obj : usersSet) {

        String uid = (String) obj;

        Identity iden =
        context.getObjectByName(Identity.class, uid);

        if (iden == null) {
        invalidUsersList.add(
        uid + " - Identity does not exist");
        continue;
        }

        if (iden.isInactive()) {
        invalidUsersList.add(
        uid + " - Identity is inactive");
        continue;
        }

        boolean isEnabledADAccount = false;

        if (application != null) {

        List links = idSvc.getLinks(iden, application);

        if (links != null) {
        for (Object linkObj : links) {

        Link link = (Link) linkObj;

        if (!link.isDisabled()) {
        isEnabledADAccount = true;
        break;
        }
        }
        }
        }

        if (isEnabledADAccount) {
        validUsersList.add(uid);
        } else {
        invalidUsersList.add(
        uid + " - AD account does not exist or is disabled");
        }
        }
        System.out.println("validUsersList::::::::::::::"+validUsersList);
        System.out.println("invalidUsersList::::::::::::::"+invalidUsersList);
        logger.info("Eligible users: " + validUsersList);
        logger.info("Ineligible users: " + invalidUsersList);

        workflow.put("usersToBeDeactivated", validUsersList);
        workflow.put("ineligibleUsers", invalidUsersList);

        boolean checkCondition = validUsersList.isEmpty();

        workflow.put("checkCondition", checkCondition);

        if (checkCondition) {

        workflow.put("message",
        "No eligible users found. " + invalidUsersList.toString());

        logger.info("No eligible users found.");
        return true;

        } else {

        workflow.put("message",
        invalidUsersList.isEmpty()
        ? ""
        : "The following users are ineligible: "
        + invalidUsersList.toString());

        logger.info(
        "Eligible users will proceed to Build Plan: "
        + validUsersList);

        return false;
        }
      </Source>
    </Script>
