  <Step icon="Default" name="Build Plan" posX="268" posY="126" resultVariable="plan">
    <Script>
      <Source>import sailpoint.object.*;
import sailpoint.api.IdentityService;
import sailpoint.object.ProvisioningPlan;
import sailpoint.object.ProvisioningPlan.AccountRequest;
import java.util.List;
import org.apache.commons.logging.Log;
import org.apache.commons.logging.LogFactory;

private static Log logger =
    LogFactory.getLog("Service Now Workflow");

List usersToBeDeactivated =
    (List) workflow.get("usersToBeDeactivated");

Integer currentUserIndex =
    (Integer) workflow.get("currentUserIndex");

if (currentUserIndex == null) {
    currentUserIndex = Integer.valueOf(0);
}

if (usersToBeDeactivated == null ||
    currentUserIndex.intValue() >= usersToBeDeactivated.size()) {
    logger.info("All eligible users have been processed.");
    return null;
}

String uid = (String) usersToBeDeactivated.get(
    currentUserIndex.intValue()
);

Identity identity =
    context.getObjectByName(Identity.class, uid);

if (identity == null || identity.isInactive()) {
    logger.warn("Skipping missing or inactive identity: " + uid);
    workflow.put("currentUserIndex",
        Integer.valueOf(currentUserIndex.intValue() + 1));
    return null;
}

Application adApplication =
    context.getObjectByName(Application.class, "AD");

if (adApplication == null) {
    throw new Exception("AD application was not found.");
}

IdentityService idSvc = new IdentityService(context);
List links = idSvc.getLinks(identity, adApplication);

Link adLink = null;

if (links != null) {
    for (Object obj : links) {
        Link link = (Link) obj;

        if (!link.isDisabled()) {
            adLink = link;
            break;
        }
    }
}

if (adLink == null) {
    logger.warn("No enabled AD account found for: " + uid);
    workflow.put("currentUserIndex",
        Integer.valueOf(currentUserIndex.intValue() + 1));
    return null;
}

ProvisioningPlan plan = new ProvisioningPlan();
plan.setIdentity(identity);

AccountRequest accountRequest = new AccountRequest();
accountRequest.setApplication("AD");
accountRequest.setNativeIdentity(adLink.getNativeIdentity());
accountRequest.setOperation(AccountRequest.Operation.Disable);

plan.add(accountRequest);

workflow.put("currentUser", uid);
workflow.put("plan", plan);

logger.info("Created AD disable plan for user: " + uid);

return plan;</Source>
