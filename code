        import java.util.List;
        import java.util.Map;
        import java.util.HashMap;

        import sailpoint.object.EmailTemplate;
        import sailpoint.object.EmailOptions;
        import sailpoint.object.EmailFileAttachment;

        System.out.println("requestIdToUserName:" + requestIdToUserName);
        System.out.println("ineligibleones:" + ineligibleUsers);

        public static String generateCsv(
        List inputFile,
        Map mapRequestIdToUserName) {

        StringBuilder contents = new StringBuilder();

        Map userNameToRequestId = new HashMap();

        for (Map.Entry entry :
        mapRequestIdToUserName.entrySet()) {
        userNameToRequestId.put(entry.getValue(), entry.getKey());
        }

        for (List list1 : inputFile) {
        for (int i = 0; i &lt; list1.size(); i++) {

        Object value = list1.get(i);

        if (value != null) {
        String userName = value.toString();

        // Get requestId using userName
        String requestId = userNameToRequestId.get(userName);

        if (requestId != null) {
        contents.append(requestId);
        } else {
        contents.append(userName);
        }
        }

        if (i &lt; list1.size() - 1) {
        contents.append(",");
        }
        }

        contents.append("\n");
        }

        return contents.toString();
        }


        List usersToBeDeactivated =
        (List) workflow.get("usersToBeDeactivated");


        String recieipnts = "";

        boolean isEmailSent = false;
        Map argList = new HashMap();

        try{
        EmailTemplate template = context.getObjectByName(EmailTemplate.class, "");
        if(null != template){
        EmailOptions ops = new EmailOptions(recieipnts, argList);
        if(usersToBeDeactivated != null &amp;&amp; !usersToBeDeactivated.isEmpty()){
        String processedUsersAttchedFile = generateCsv(usersToBeDeactivated);
        EmailFileAttachment processedIdenAttachement = new EmailFileAttachment("", EmailFileAttachment.MimeType.MIME_CSV,
        processedUsersAttchedFile.toString().getBytes());
        ops.addAttachment(processedIdenAttachement);
        }
        context.sendEmailNotification(template, ops);
        }
        isEmailSent = true;
        }
        catch (Exception e) {
        log.error("Error Occurred while sending the mail");
        isEmailSent = false;
        e.printStackTrace();
        }

      </Source>
